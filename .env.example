# Supabase project envs
# - NEXT_PUBLIC_*  : safe to expose in the browser; protected by RLS
# - SUPABASE_SERVICE_ROLE_KEY : bypasses ALL RLS — server-only, NEVER prefix NEXT_PUBLIC_

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public site URL — used by sitemap, robots, OG image, canonical links.
# Defaults to http://localhost:3000 when unset (dev only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
