# Supabase project envs
# - NEXT_PUBLIC_*  : safe to expose in the browser; protected by RLS
# - SUPABASE_SERVICE_ROLE_KEY : bypasses ALL RLS — server-only, NEVER prefix NEXT_PUBLIC_

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public site URL — used by sitemap, robots, OG image, canonical links.
# Defaults to http://localhost:3000 when unset (dev only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 (opcional). Vazio = o Analytics nao carrega, nem para
# quem aceitou os cookies. O ID sai de analytics.google.com -> Admin ->
# Fluxos de dados -> Web.
NEXT_PUBLIC_GA_ID=

# --- Shopee Open Platform (integração Shopee -> site) -----------------------
# Console App em https://open.shopee.com (precisa de CNPJ ativo no BR).
# O partner key ASSINA todas as chamadas: server-only, nunca NEXT_PUBLIC_.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# br (padrão) | global | sandbox
SHOPEE_REGION=br
# Deve bater exatamente com um redirect cadastrado no Console App.
# Default: ${NEXT_PUBLIC_SITE_URL}/api/shopee/callback
SHOPEE_REDIRECT_URL=

# Segredo do cron da Vercel que dispara /api/shopee/sync (também renova o token).
CRON_SECRET=

# --- Contas de cliente (/conta) -------------------------------------------
# Compra pelo site: sempre ligada. Só para emergência (voltar ao pedido pelo
# WhatsApp): NEXT_PUBLIC_COMPRA_NO_SITE=desligada. A antiga
# NEXT_PUBLIC_CONTAS_ATIVAS não é mais usada; pode apagar da hospedagem.
NEXT_PUBLIC_COMPRA_NO_SITE=
# Chave da prévia, pra testar com as contas desligadas: abra
#   https://unibolsas.store/api/conta/previa?chave=<esta chave>
# no seu navegador. Mínimo 16 caracteres; vazio = prévia fechada.
# Pra sair da prévia: /api/conta/previa?sair=1
CONTAS_PREVIA_CHAVE=
# E-mails das contas (confirmação, nova senha) saem pelo Resend
# (resend.com). Server-only, nunca NEXT_PUBLIC_.
RESEND_API_KEY=
# Remetente; o domínio precisa estar verificado no Resend.
EMAIL_REMETENTE=Uni Bolsas <contato@unibolsas.store>

# --- Compra pelo site (Mercado Pago Checkout Pro) --------------------------
# Só funciona com as contas liberadas (compra pelo site ligada ou prévia).
# Access Token: mercadopago.com.br/developers → sua aplicação → Credenciais.
# Comece com o de TESTE; troque pelo de PRODUÇÃO pra vender de verdade.
MERCADOPAGO_ACCESS_TOKEN=
# "Assinatura secreta" da tela Webhooks da aplicação (URL do aviso:
# https://unibolsas.store/api/mercadopago/aviso, evento "Pagamentos").
MERCADOPAGO_WEBHOOK_SECRET=
# E-mail(s) da loja que recebem o aviso de cada venda (separe com vírgula).
PEDIDOS_EMAIL=
# Só pra teste local com um Mercado Pago de mentira. Em produção, NÃO defina.
# MERCADOPAGO_API_URL=

# --- Frete (Melhor Envio) ---------------------------------------------------
# Token: melhorenvio.com.br → Configurações → Permissões de acesso → gerar
# token com "shipping-calculate". Server-only. Vazio = só retirada e frete a
# combinar. Caixas e pesos médios: lib/frete/caixas.ts.
MELHORENVIO_TOKEN=
# "sandbox" usa o ambiente de testes do Melhor Envio; vazio = produção.
MELHORENVIO_AMBIENTE=
# Só pra teste local com um Melhor Envio de mentira. Em produção, NÃO defina.
# MELHORENVIO_API_URL=

# --- Nota fiscal automática (Focus NFe) — a opção principal ----------------
# Token da empresa no painel da Focus NFe (segredo). O certificado A1 é
# enviado no painel DELES, nunca aqui.
FOCUSNFE_TOKEN=
# "producao" = notas de verdade. Vazio ou outro valor = homologação (teste,
# sem valor fiscal; os pedidos reais não emitem, só o botão de teste em
# /admin/integracoes).
FOCUSNFE_AMBIENTE=
# Dados fiscais (o contador confirma). Padrões de Simples Nacional entre ().
# NCM: escolha por categoria em /admin/integracoes. Este vale para as
# categorias que ficarem sem NCM (opcional).
NFE_NCM=
# NFE_CFOP_ESTADUAL=        (5102)
# NFE_CFOP_INTERESTADUAL=   (6102)
# NFE_CSOSN=                (102)
# NFE_PIS_COFINS=           (49)
# NFE_NATUREZA=             (Venda de mercadoria)
# Só pra teste local. Em produção, NÃO defina.
# FOCUSNFE_API_URL=

# --- Nota fiscal automática (Bling) — alternativa -------------------------
# Só é usado se FOCUSNFE_TOKEN estiver vazio.
# Aplicativo criado em Bling → Central de extensões → Área do integrador.
# URL de redirecionamento do app: https://unibolsas.store/api/bling/retorno
# Depois de configurar, conecte em /admin/integracoes → "Conectar Bling".
BLING_CLIENT_ID=
BLING_CLIENT_SECRET=
# NCM padrão das peças (o contador informa; ex.: 4202.22.10). Usado ao
# cadastrar no Bling um produto que ainda não existe lá.
BLING_NCM=
# Só pra teste local. Em produção, NÃO defina.
# BLING_API_URL=
# BLING_AUTH_URL=
# Etiqueta automática (Melhor Envio): o MELHORENVIO_TOKEN precisa das
# permissões cart-read, cart-write, shipping-calculate, shipping-checkout,
# shipping-generate, shipping-print, shipping-tracking e orders-read, e a
# Carteira do Melhor Envio precisa ter saldo.
