# Supabase project envs
# - NEXT_PUBLIC_*  : safe to expose in the browser; protected by RLS
# - SUPABASE_SERVICE_ROLE_KEY : bypasses ALL RLS — server-only, NEVER prefix NEXT_PUBLIC_

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
