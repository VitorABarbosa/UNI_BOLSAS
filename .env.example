# Supabase project envs
# - NEXT_PUBLIC_*  : safe to expose in the browser; protected by RLS
# - SUPABASE_SERVICE_ROLE_KEY : bypasses ALL RLS — server-only, NEVER prefix NEXT_PUBLIC_

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Public site URL — used by sitemap, robots, OG image, canonical links.
# Defaults to http://localhost:3000 when unset (dev only).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Shopee Open Platform (integração Shopee -> site) -----------------------
# Console App em https://open.shopee.com (precisa de CNPJ ativo no BR).
# O partner key ASSINA todas as chamadas: server-only, nunca NEXT_PUBLIC_.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# br (padrão) | global | sandbox
SHOPEE_REGION=br
# Deve bater exatamente com um redirect cadastrado no Console App.
# Default: ${NEXT_PUBLIC_SITE_URL}/api/shopee/callback
SHOPEE_REDIRECT_URL=

# Segredo do cron da Vercel que dispara /api/shopee/sync (também renova o token).
CRON_SECRET=
